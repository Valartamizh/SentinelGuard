# SentinelGuard — Environment Variables Template
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_PASSWORD=<choose-a-strong-password>
DB_PASSWORD=<same-as-POSTGRES_PASSWORD>

# JWT secret — Base64-encoded string of at least 32 random bytes.
# Generate: openssl rand -base64 64
JWT_SECRET=<base64-encoded-256-bit-minimum-secret>

# Administrator bootstrap credentials (used ONCE on first startup).
# BCrypt-hashed before database storage. Plaintext never persisted.
# To reset admin: DELETE FROM admin_users; restart with new values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<choose-a-strong-admin-password>
